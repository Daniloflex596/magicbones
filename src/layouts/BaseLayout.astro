---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noIndex?: boolean;
}

const {
  title,
  description,
  ogImage = '/og-default.png',
  noIndex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Magic Bones',
  url: Astro.site?.toString(),
  logo: new URL(withBase('/favicon.svg'), Astro.site).toString(),
  founder: { '@type': 'Person', name: 'Claudia Capitani' },
  areaServed: 'Roma, IT',
  sameAs: ['https://www.instagram.com/_magic_bones'],
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+39-328-363-2440',
    email: 'magicbones111@gmail.com',
    contactType: 'customer service',
  },
};
---

<!doctype html>
<html lang="it">
  <head>
    <script is:inline>
      // Batte sul tempo il browser: refresh riparte sempre dall'alto.
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="canonical" href={canonicalURL} />
    {noIndex && <meta name="robots" content="noindex,nofollow" />}

    <title>{title} · Magic Bones</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · Magic Bones`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(withBase(ogImage), Astro.site)} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · Magic Bones`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(withBase(ogImage), Astro.site)} />

    <ClientRouter />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,500&family=Jost:wght@400;500;600&family=Pirata+One&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />

    <noscript>
      <style>
        [data-reveal],
        [data-stagger] > *,
        .split-inner {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <a href="#contenuto" class="skip-link">Salta al contenuto</a>
    <slot />

    <script>
      // Smooth scroll (Lenis) — l'inerzia su cui si innestano i reveal e la
      // parallasse. Mai sotto reduced-motion: lì lo scroll resta quello
      // nativo del browser, che è esattamente ciò che l'utente ha chiesto.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const { default: Lenis } = await import('lenis');
        const lenis = new Lenis({ duration: 1.05, smoothWheel: true, touchMultiplier: 1.6 });
        let raf = 0;
        const loop = (time: number) => {
          lenis.raf(time);
          raf = requestAnimationFrame(loop);
        };
        raf = requestAnimationFrame(loop);

        // Astro ClientRouter: smonta prima di una navigazione soft, così non
        // resta un secondo loop orfano sulla pagina successiva.
        document.addEventListener('astro:before-swap', () => {
          cancelAnimationFrame(raf);
          lenis.destroy();
        }, { once: true });
      }
    </script>
  </body>
</html>
