---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { CartButton } from '../components/shop/CartButton';
import { CartDrawer } from '../components/shop/CartDrawer';
import { PannelloProdotto } from '../components/world/PannelloProdotto';
import { toPlainProduct } from '../lib/types';
import { withBase } from '../lib/url';

/*
 * I pezzi che vivono DENTRO il mondo, nei barattoli dell'atto dei teschi.
 * Gli stessi id sono cablati in world.js (BARATTOLI_TESCHI): il raycast
 * restituisce l'id, il DOM apre il pannello. Se un id qui e in world.js
 * divergessero, il tocco nel mondo non troverebbe il prodotto — per questo
 * l'ordine e identico e la fonte e la stessa collection.
 */
const NEI_BARATTOLI = ['teschio-toro-pentagramma', 'teschio-uccello-ametista', 'teschio-serpente-scaglie'];
const tutti = await getCollection('products');
const pezziDelMondo = NEI_BARATTOLI.map((id) => tutti.find((p) => p.id === id))
  .filter((p): p is NonNullable<typeof p> => Boolean(p))
  .map(toPlainProduct);

/*
 * IL SOTTOBOSCO — home immersiva.
 *
 * Ogni <section class="atto"> e un POSTO nello spazio 3D, non un blocco di
 * pagina: il suo id e mappato su una stazione della camera in stations.js e la
 * timeline di scroll tiene le due cose sulla stessa progressione — quando una
 * sezione e al centro del viewport, la camera e al suo waypoint.
 *
 * Il testo vive in DOM semantico: a motore spento (reduced-motion, no-WebGL,
 * saveData, RAM <= 2GB, JS assente) la pagina resta leggibile e navigabile per
 * intero. Il 3D e progressive enhancement, mai il portatore del contenuto.
 */
---

<BaseLayout
  title="Il Sottobosco"
  description="Magic Bones — teschi dipinti a mano, gioielli in osso e altari rituali di Claudia Capitani, Roma. Attraversa il sottobosco."
>
  <div class="preloader" id="preloader" aria-hidden="true">
    <!-- Un barattolo che si riempie: il logo di Claudia e una mano che regge
         un barattolo con dentro un teschio, quindi anche l'attesa e a tema. -->
    <div class="preloader__vessel"><span class="preloader__fill" data-fill></span></div>
    <p class="preloader__pct" data-pct>0%</p>
  </div>

  <header class="site-header">
    <a href={withBase('/')} class="site-header__logo">Magic Bones</a>
    <nav class="site-header__nav">
      <a href={withBase('/negozio')} data-astro-reload>Negozio</a>
      <a href={withBase('/chi-e-claudia')} data-astro-reload>Chi è Claudia</a>
      <a href={withBase('/contatti')} data-astro-reload>Contatti</a>
    </nav>
    <CartButton client:load />
    <CartDrawer client:load />
  </header>

  <!-- Il mondo. Fisso dietro tutto: gli atti ci scorrono sopra. -->
  <div class="stage" id="stage">
    <canvas id="mondo" class="stage__canvas" aria-hidden="true"></canvas>
    <div class="stage__scrim" aria-hidden="true"></div>
  </div>

  <main id="contenuto" class="atti">
    <!-- 0 · LA SOGLIA — establishing -->
    <section class="atto atto--soglia" id="atto-soglia">
      <div class="atto__testo">
        <p class="occhiello">Roma · fatto a mano</p>
        <h1 class="wordmark">
          <span class="wordmark__magic">Magic</span>
          <span class="wordmark__bones">Bones</span>
        </h1>
        <p class="sottotitolo">
          Claudia Capitani dipinge ossa di animali, monta cristalli sul muschio e
          fonde candele per piccoli riti quotidiani.
        </p>
        <p class="invito">Scendi nel sottobosco ↓</p>
      </div>
    </section>

    <!-- 1 · IL BOSCO DELLE OSSA — il signature moment -->
    <section class="atto atto--ossa" id="atto-ossa">
      <div class="atto__testo">
        <p class="occhiello">Atto primo</p>
        <h2>Quelle non sono gambi di fungo</h2>
        <p>
          Nel sottobosco le colonne pallide si somigliano tutte. Poi ci passi
          accanto, la luce sale, e tre di quelle colonne si rivelano per quello
          che sono: <strong>ossa dipinte a mano</strong>, una per una, mai due
          uguali.
        </p>
        <p class="nota">È da qui che viene il nome della bottega.</p>
      </div>
    </section>

    <!-- 2 · I TESCHI DIPINTI -->
    <section class="atto atto--teschi" id="atto-teschi">
      <div class="atto__testo">
        <p class="occhiello">Atto secondo</p>
        <h2>I teschi</h2>
        <p>
          Capra, cervo, toro, pitone. Ogni cranio viene pulito, preparato e
          dipinto a mano. Qui sono nei barattoli, tra le radici:
          <strong>toccane uno</strong> per guardarlo da vicino.
        </p>
        <PannelloProdotto client:load prodotti={pezziDelMondo} />
        <a class="btn btn--minore" href={withBase('/negozio')}>Tutti i teschi in negozio →</a>
      </div>
    </section>

    <!-- 3 · IL FILO D'OSSO -->
    <section class="atto atto--gioielli" id="atto-gioielli">
      <div class="atto__testo">
        <p class="occhiello">Atto terzo</p>
        <h2>Il filo d'osso</h2>
        <p>
          Vertebre, falangi e denti diventano ciondoli montati su cordino nero.
          Piccoli, leggeri, pensati per essere portati tutti i giorni — non per
          restare in una teca.
        </p>
        <a class="btn" href={withBase('/negozio')}>Guarda i gioielli →</a>
      </div>
    </section>

    <!-- 4 · IL FUOCO RITUALE -->
    <section class="atto atto--fuoco" id="atto-fuoco">
      <div class="atto__testo">
        <p class="occhiello">Atto quarto</p>
        <h2>Il fuoco</h2>
        <p>
          Candele in cera naturale tinte a mano, altari su tessuto ragnatela,
          dischi zodiacali in resina. La parte calda del bosco: quella che si
          accende la sera e resta accesa.
        </p>
        <a class="btn" href={withBase('/negozio')}>Guarda candele e altari →</a>
      </div>
    </section>

    <!-- 5 · PANORAMICA — respiro e scala -->
    <section class="atto atto--panoramica" id="atto-panoramica">
      <div class="atto__testo atto__testo--centro">
        <h2 class="grande">Tutto quello che vedi<br />esiste in un pezzo solo</h2>
        <p>
          Niente serie, niente stampi. Quando un pezzo è andato, è andato — e il
          prossimo sarà diverso.
        </p>
      </div>
    </section>

    <!-- 6 · IL BANCO DI CLAUDIA — contro-campo e chiusura -->
    <section class="atto atto--banco" id="atto-banco">
      <div class="atto__testo">
        <p class="occhiello">Il banco</p>
        <h2>Claudia</h2>
        <p>
          Lavora a Roma, spesso sotto una lampada e sempre con le mani sporche.
          Scrivile: risponde lei, e conferma disponibilità, misure e spedizione
          prima che tu paghi qualsiasi cosa.
        </p>
        <div class="azioni">
          <a class="btn btn--primario" href={withBase('/negozio')} data-astro-reload>
            Entra nel negozio →
          </a>
          <a class="btn" href={withBase('/chi-e-claudia')} data-astro-reload>Chi è Claudia</a>
        </div>
      </div>
    </section>
  </main>

  <script>
    import { mountWorld } from '../components/world/mount.js';

    const canvas = document.getElementById('mondo') as HTMLCanvasElement | null;
    if (canvas) {
      mountWorld({
        canvas,
        preloaderEl: document.getElementById('preloader'),
        stageEl: document.getElementById('stage'),
        basePath: import.meta.env.BASE_URL,
        // Il mondo non apre niente da solo: annuncia il pezzo toccato e il
        // punto sullo schermo. Il pannello React ascolta e apre — cosi la via
        // 3D e quella da tastiera finiscono esattamente nello stesso posto.
        onPick(productId: string, punto: { x: number; y: number } | null) {
          window.dispatchEvent(
            new CustomEvent('mondo:prendi', { detail: { productId, punto } }),
          );
        },
      });
    }
  </script>

  <style>
    /* --- Preloader --------------------------------------------------------- */
    .preloader {
      position: fixed; inset: 0; z-index: 60;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      gap: 1rem; background: var(--soil-deep);
      transition: opacity 0.6s ease, visibility 0.6s ease;
    }
    .preloader.is-done { opacity: 0; visibility: hidden; pointer-events: none; }
    .preloader__vessel {
      width: 46px; height: 64px; border: 2px solid var(--bone-shade);
      border-radius: 6px 6px 12px 12px; overflow: hidden;
      display: flex; align-items: flex-end;
    }
    .preloader__fill {
      display: block; width: 100%; height: 0%;
      background: linear-gradient(var(--amanita), var(--amanita-deep));
      transition: height 0.35s ease;
    }
    .preloader__pct {
      font-family: var(--font-body); font-size: 0.75rem; letter-spacing: 0.14em;
      color: var(--bone-shade); margin: 0;
    }

    /* --- Header ------------------------------------------------------------ */
    .site-header {
      position: fixed; top: 0; left: 0; right: 0; z-index: 40;
      display: flex; align-items: center; gap: 1rem;
      padding: 1rem clamp(1rem, 4vw, 2.5rem);
    }
    .site-header__logo {
      font-family: var(--font-display); font-weight: 700; font-size: 1.15rem;
      color: var(--bone-light); text-decoration: none; letter-spacing: 0.02em;
    }
    .site-header__nav { display: flex; gap: 1.25rem; margin-left: auto; }
    .site-header__nav a {
      font-family: var(--font-body); font-size: 0.86rem;
      color: var(--fg-dim); text-decoration: none;
    }
    .site-header__nav a:hover { color: var(--bone-light); }
    @media (max-width: 640px) { .site-header__nav { display: none; } }

    /* --- Il mondo ---------------------------------------------------------- */
    .stage { position: fixed; inset: 0; z-index: 0; background: var(--soil-deep); }
    .stage__canvas { display: block; width: 100%; height: 100%; }
    /* Scrim laterale: senza, il testo chiaro sopra un cappello rosso e
       illeggibile. La skill lo elenca tra gli errori che spengono la scena. */
    .stage__scrim {
      position: absolute; inset: 0; pointer-events: none;
      /*
       * Orizzontale (90deg), NON diagonale. A 100deg il gradiente ha un bordo
       * obliquo: finche la scena era buia non si notava, ma con il sottobosco
       * folto e luminoso quel cuneo si staccava come una lastra nera in
       * diagonale sopra mezza inquadratura.
       * Le fermate sono anche piu graduali: un salto da 0.74 a 0.12 in 26
       * punti percentuali si vede come un bordo, non come una velatura.
       */
      background: linear-gradient(
        90deg,
        rgba(15, 11, 30, 0.88) 0%,
        rgba(15, 11, 30, 0.78) 18%,
        rgba(15, 11, 30, 0.55) 32%,
        rgba(15, 11, 30, 0.26) 45%,
        rgba(15, 11, 30, 0.08) 56%,
        rgba(15, 11, 30, 0) 66%
      );
    }

    /* --- Gli atti ---------------------------------------------------------- */
    .atti { position: relative; z-index: 1; }
    .atto {
      /* lvh, non svh: la barra indirizzi mobile non deve cambiare l'altezza
         sotto i piedi mentre si scorre. */
      min-height: 100lvh;
      display: flex; align-items: center;
      padding: clamp(2rem, 6vw, 5rem);
    }
    .atto__testo { max-width: 30rem; }
    .atto__testo--centro { max-width: 38rem; margin-inline: auto; text-align: center; }

    .occhiello {
      font-family: var(--font-body); font-size: 0.72rem; letter-spacing: 0.22em;
      text-transform: uppercase; color: var(--moss); margin: 0 0 0.75rem;
    }
    .atto h2 {
      font-family: var(--font-display); font-weight: 600;
      font-size: clamp(2rem, 5.2vw, 3.4rem); line-height: 1.06;
      color: var(--bone-light); margin: 0 0 1rem; text-wrap: balance;
    }
    .atto h2.grande { font-size: clamp(2.4rem, 6.4vw, 4.4rem); }
    .atto p {
      font-family: var(--font-body); font-size: clamp(0.98rem, 1.5vw, 1.1rem);
      line-height: 1.65; color: var(--fg-dim); margin: 0 0 1rem; max-width: 34ch;
    }
    .atto__testo--centro p { max-width: none; margin-inline: auto; }
    .atto p strong { color: var(--amanita-spot); font-weight: 500; }
    .nota { font-size: 0.9rem !important; color: var(--bone-shade) !important; font-style: italic; }

    /* --- Wordmark ---------------------------------------------------------- */
    .wordmark {
      font-family: var(--font-display); font-weight: 700;
      font-size: clamp(3.2rem, 11vw, 7rem); line-height: 0.9;
      margin: 0 0 1.25rem; display: flex; flex-direction: column;
    }
    .wordmark__magic { color: var(--bone-light); }
    .wordmark__bones {
      color: var(--amanita); font-style: italic;
      text-shadow: var(--glow-amanita);
    }
    .sottotitolo {
      font-size: clamp(1rem, 1.7vw, 1.18rem) !important;
      color: var(--bone) !important; max-width: 32ch;
    }
    .invito {
      font-family: var(--font-body); font-size: 0.8rem !important;
      letter-spacing: 0.16em; text-transform: uppercase;
      color: var(--moss) !important; margin-top: 2rem !important;
    }

    /* --- Azioni ------------------------------------------------------------ */
    .azioni { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
    .btn {
      display: inline-flex; align-items: center;
      font-family: var(--font-body); font-size: 0.92rem;
      padding: 0.75rem 1.5rem; border-radius: var(--r-sm); text-decoration: none;
      color: var(--bone-light); border: 1px solid rgba(220, 197, 158, 0.34);
      min-height: 2.75rem; transition: background 0.2s ease, border-color 0.2s ease;
    }
    .btn:hover { background: rgba(220, 197, 158, 0.1); border-color: var(--bone); }
    .btn--primario {
      background: var(--amanita); border-color: var(--amanita); color: var(--soil-deep);
      font-weight: 500;
    }
    .btn--primario:hover { background: var(--amanita-spot); border-color: var(--amanita-spot); }
    .btn:focus-visible { outline: 2px solid var(--moss); outline-offset: 3px; }

    /* --- Motore spento: il contenuto deve reggere da solo ------------------ */
    :global(html[data-world-mode='statico']) .stage__canvas { display: none; }
    :global(html[data-world-mode='statico']) .stage {
      background:
        radial-gradient(80% 55% at 20% 12%, rgba(232, 64, 44, 0.2), transparent 62%),
        radial-gradient(70% 50% at 82% 68%, rgba(139, 95, 201, 0.22), transparent 60%),
        var(--soil-deep);
    }
    :global(html[data-world-mode='statico']) .stage__scrim { opacity: 0.55; }

    @media (prefers-reduced-motion: reduce) {
      .preloader { display: none; }
    }

    @media (max-width: 640px) {
      /* Su mobile lo scrim sale dal basso: il testo sta in fondo allo schermo. */
      .stage__scrim {
        background: linear-gradient(
          to top,
          rgba(15, 11, 30, 0.95) 0%,
          rgba(15, 11, 30, 0.78) 34%,
          rgba(15, 11, 30, 0.1) 68%,
          rgba(15, 11, 30, 0) 84%
        );
      }
      .atto { align-items: flex-end; padding-bottom: 3.5rem; }
      .atto--soglia { align-items: center; }
    }
  </style>
</BaseLayout>
