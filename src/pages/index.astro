---
import BaseLayout from '../layouts/BaseLayout.astro';
import StaticFallback from '../components/world/fallback/StaticFallback.astro';
---

<BaseLayout
  title="Un bosco notturno di ossa e magia"
  description="Magic Bones — teschi dipinti a mano, gioielli in osso e altari rituali di Claudia Capitani. Addentrati nel bosco sacro, scrollando."
>
  <StaticFallback />

  <div id="preloader" class="preloader" aria-hidden="true">
    <svg class="preloader-glyph" viewBox="0 0 64 64" width="72" height="72">
      <path
        d="M32 14c-10 0-16 7-16 16 0 6 2.5 10 5 12.5V50h4.5v-4h3.5v4H33v-4h3.5v4H41v-7.5c2.5-2.5 5-6.5 5-12.5 0-9-6-16-16-16Z"
        fill="none" stroke="#e4d9b8" stroke-width="2.2" stroke-linejoin="round"
      />
      <circle class="preloader-glyph-eye" cx="25.5" cy="27" r="3" fill="#2fb8c4" />
      <circle class="preloader-glyph-eye" cx="38.5" cy="27" r="3" fill="#2fb8c4" />
    </svg>
    <p class="preloader-word">Magic Bones</p>
    <div class="preloader-track"><div data-fill class="preloader-fill"></div></div>
    <span data-pct class="preloader-pct">0%</span>
  </div>

  <canvas id="world-canvas" aria-hidden="true"></canvas>

  <main id="contenuto">
    <section id="soglia" class="station station--center">
      <div class="scrim scrim--center" data-reveal>
        <p class="eyebrow">Magic Bones</p>
        <h1 class="display-title">Un bosco notturno<br />di ossa e magia</h1>
        <p class="lede">
          Ogni pezzo è raccolto, dipinto e incastonato a mano da Claudia Capitani,
          artista esoterica di Roma. Scrolla per addentrarti.
        </p>
      </div>
    </section>

    <section id="funghi" class="station station--left">
      <div class="scrim" data-reveal>
        <p class="eyebrow">La Radura dei Funghi</p>
        <h2 class="display-title">Nasce nel buio,<br />come dopo la pioggia</h2>
        <p class="lede">
          "I create with skeletons" — ogni creazione di Magic Bones cresce lenta,
          tra muschio e bioluminescenza, prima di raggiungere l'altare.
        </p>
      </div>
    </section>

    <section id="teschi" class="station station--right">
      <div class="scrim" data-reveal>
        <p class="eyebrow">L'Altare dei Teschi</p>
        <h2 class="display-title">Teschi dipinti<br />a mano</h2>
        <p class="lede">
          Mandala, pietre turchesi, finiture oro: ogni cranio è un pezzo unico,
          mai una copia.
        </p>
        <a class="cta" href="/negozio?categoria=teschio-dipinto" data-astro-reload>Scopri la collezione →</a>
      </div>
    </section>

    <section id="filoNero" class="station station--left">
      <div class="scrim" data-reveal>
        <p class="eyebrow">Il Filo Nero</p>
        <h2 class="display-title">Gioielli in osso,<br />appesi al buio</h2>
        <p class="lede">
          Ciondoli, dischi dreamcatcher in pizzo nero: da indossare come un
          talismano.
        </p>
        <a class="cta" href="/negozio?categoria=gioiello-osso" data-astro-reload>Scopri la collezione →</a>
      </div>
    </section>

    <section id="focolare" class="station station--right">
      <div class="scrim" data-reveal>
        <p class="eyebrow">Il Focolare Rituale</p>
        <h2 class="display-title">Candele, tarocchi<br />e altari</h2>
        <p class="lede">
          Oggetti per il rito quotidiano: dischi zodiacali, candele, fiori
          secchi su tessuto nero.
        </p>
        <a class="cta" href="/negozio?categoria=arredo-rituale" data-astro-reload>Scopri la collezione →</a>
      </div>
    </section>

    <section id="panoramica" class="station station--center">
      <div class="scrim scrim--center" data-reveal>
        <p class="eyebrow">Ti volti indietro</p>
        <h2 class="display-title">Hai attraversato<br />il bosco intero</h2>
        <p class="lede">Ogni radura resta accesa alle tue spalle, nel buio.</p>
      </div>
    </section>

    <section id="controAltare" class="station station--left">
      <div class="scrim" data-reveal>
        <p class="eyebrow">L'Altare di Claudia</p>
        <h2 class="display-title">Personalizzazioni<br />su richiesta</h2>
        <p class="lede">
          Roma based. Ogni pezzo può nascere su misura: scrivi a Claudia per
          raccontarle la tua idea.
        </p>
        <a class="cta" href="/chi-e-claudia" data-astro-reload>Conosci Claudia →</a>
      </div>
    </section>

    <section id="chiusura" class="station station--center station--closing">
      <div class="scrim scrim--center" data-reveal>
        <p class="eyebrow">Il viaggio continua</p>
        <h2 class="display-title">Entra nel negozio</h2>
        <p class="lede">Porta a casa un pezzo del bosco.</p>
        <a class="cta cta--primary" href="/negozio" data-astro-reload>Entra nel negozio →</a>
        <p class="contact-line">
          <a href="https://www.instagram.com/_magic_bones" target="_blank" rel="noopener noreferrer">@_magic_bones</a>
          · <a href="/contatti" data-astro-reload>contatti</a>
        </p>
      </div>
    </section>
  </main>

  <script>
    import { setupScrollRestoration, createPreloader, bootImmersive } from '../components/world/engine/boot.js';
    import { detectTier } from '../components/world/engine/capability.js';
    import { setupReveal } from '../lib/reveal.js';

    setupScrollRestoration();
    setupReveal();

    const preloaderEl = document.getElementById('preloader');
    const preloader = createPreloader(preloaderEl);
    const canvas = document.getElementById('world-canvas');
    const tier = detectTier();

    if (tier === 'none') {
      document.body.classList.add('no-engine');
    }

    bootImmersive({
      canvas,
      tier,
      loadEngine: async (canvasEl, t) => {
        const { initWorld } = await import('../components/world/world.js');
        return initWorld(canvasEl, { tier: t });
      },
      loadFallback: async () => {
        document.body.classList.add('no-engine');
        return null;
      },
      onProgress: (p) => preloader.setProgress(p),
    }).then(({ mode }) => {
      preloader.done();
      if (mode === 'fallback') document.body.classList.add('no-engine');
    });
  </script>

  <style>
    #world-canvas {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: -1;
      display: block;
    }

    main {
      position: relative;
      z-index: 1;
    }

    .preloader {
      position: fixed;
      inset: 0;
      z-index: 50;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      background: var(--night-deep);
      transition: opacity 0.6s ease;
      pointer-events: none;
    }
    .preloader.is-done {
      opacity: 0;
    }
    .preloader-glyph {
      filter: drop-shadow(0 0 10px rgba(47, 184, 196, 0.45));
      animation: preloader-breathe 2.4s ease-in-out infinite;
    }
    .preloader-glyph-eye {
      animation: preloader-blink 2.4s ease-in-out infinite;
    }
    @keyframes preloader-breathe {
      0%, 100% { transform: scale(1); opacity: 0.85; }
      50% { transform: scale(1.08); opacity: 1; }
    }
    @keyframes preloader-blink {
      0%, 40%, 100% { opacity: 1; }
      50% { opacity: 0.25; }
    }
    .preloader-word {
      font-family: var(--font-flash);
      font-size: 1.1rem;
      letter-spacing: 0.08em;
      color: var(--amanita-glow);
      opacity: 0;
      animation: preloader-word-in 1.2s ease 0.3s forwards;
    }
    @keyframes preloader-word-in {
      to { opacity: 0.85; }
    }
    .preloader-track {
      width: 3px;
      height: 70px;
      background: rgba(228, 217, 184, 0.15);
      border-radius: 2px;
      overflow: hidden;
      display: flex;
      align-items: flex-end;
      margin-top: 0.5rem;
    }
    .preloader-fill {
      width: 100%;
      height: 0%;
      background: var(--amanita-glow);
      transition: height 0.3s ease;
    }
    .preloader-pct {
      font-family: var(--font-body);
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      color: var(--bone-cream);
      opacity: 0.7;
    }

    .station {
      min-height: 100lvh;
      display: flex;
      align-items: center;
      padding: 4rem 6vw;
    }
    .station--center {
      justify-content: center;
      text-align: center;
    }
    .station--left {
      justify-content: flex-start;
    }
    .station--right {
      justify-content: flex-end;
    }
    .station--closing {
      min-height: 100lvh;
    }

    .scrim {
      max-width: 30rem;
      background: linear-gradient(135deg, rgba(12, 15, 26, 0.82), rgba(12, 15, 26, 0.55));
      border: 1px solid rgba(228, 217, 184, 0.12);
      border-radius: var(--radius-lg);
      padding: 2rem 2.25rem;
      backdrop-filter: blur(2px);
    }
    .scrim--center {
      max-width: 36rem;
    }

    .eyebrow {
      font-family: var(--font-flash);
      color: var(--amanita-glow);
      font-size: 0.9rem;
      letter-spacing: 0.06em;
      margin-bottom: 0.5rem;
    }
    .display-title {
      font-family: var(--font-display);
      font-size: clamp(1.9rem, 4vw, 3rem);
      line-height: 1.15;
      color: var(--bone-cream);
      margin-bottom: 0.9rem;
    }
    .lede {
      font-family: var(--font-body);
      font-size: 1rem;
      line-height: 1.6;
      color: rgba(228, 217, 184, 0.85);
      margin-bottom: 1.25rem;
    }
    .cta {
      position: relative;
      display: inline-block;
      font-family: var(--font-body);
      font-weight: 500;
      color: var(--turquoise);
      text-decoration: none;
      padding: 0.6rem 0.05rem;
      margin: -0.6rem -0.05rem;
      min-height: 44px;
      box-sizing: border-box;
    }
    .cta::after {
      content: '';
      position: absolute;
      left: 0.05rem;
      right: 0.05rem;
      bottom: 0.5rem;
      height: 1px;
      background: currentColor;
      transform: scaleX(1);
      transform-origin: left;
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cta:hover::after {
      transform: scaleX(0.35);
    }
    .cta--primary {
      color: var(--night-deep);
      background: var(--amanita-glow);
      border: none;
      padding: 0.85rem 1.5rem;
      border-radius: 999px;
      margin: 0 0 1rem;
      min-height: 44px;
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
    }
    .cta--primary::after {
      display: none;
    }
    .cta--primary:hover {
      transform: translateY(-2px) scale(1.03);
      box-shadow: 0 8px 24px rgba(255, 138, 77, 0.35);
    }
    .contact-line {
      font-family: var(--font-body);
      font-size: 0.85rem;
      color: rgba(228, 217, 184, 0.7);
    }
    .contact-line a {
      color: var(--bone-cream);
      padding: 0.6rem 0.3rem;
      margin: -0.6rem -0.3rem;
      display: inline-block;
    }

    /*
     * Su schermi stretti il pannello di testo occupava quasi tutto il
     * riquadro, lasciando vedere solo un'unghia del mondo 3D dietro: lo
     * scrim si fa più compatto (meno padding, testo più piccolo) così la
     * scena resta protagonista anche sul telefono, che è il device guida.
     */
    @media (max-width: 480px) {
      .station {
        padding: 2.75rem 5vw;
      }
      .scrim {
        padding: 1.35rem 1.5rem;
        max-width: min(20rem, 78vw);
      }
      .scrim--center {
        max-width: min(22rem, 86vw);
      }
      .display-title {
        font-size: clamp(1.5rem, 7vw, 2rem);
        margin-bottom: 0.6rem;
      }
      .lede {
        font-size: 0.9rem;
        margin-bottom: 0.9rem;
      }
      .eyebrow {
        font-size: 0.78rem;
        margin-bottom: 0.35rem;
      }
    }
  </style>
</BaseLayout>
