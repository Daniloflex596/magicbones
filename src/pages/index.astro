---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { CartButton } from '../components/shop/CartButton';
import { CartDrawer } from '../components/shop/CartDrawer';
import { CategoryTiles } from '../components/home/CategoryTiles';
import { GalleryPreview } from '../components/home/GalleryPreview';
import { FeaturedStrip } from '../components/home/FeaturedStrip';
import { toPlainProduct } from '../lib/types';
import { withBase } from '../lib/url';

const entries = await getCollection('products');
const featured = entries.filter((e) => e.data.featured).slice(0, 4).map(toPlainProduct);
---

<BaseLayout
  title="Teschi dipinti, gioielli in osso e altari rituali"
  description="Magic Bones — Claudia Capitani, Roma. Teschi dipinti a mano, gioielli in osso, altari rituali. Pezzi unici, personalizzabili su richiesta."
>
  <header class="site-header">
    <a href={withBase('/')} class="site-header__logo">Magic Bones</a>
    <nav class="site-header__nav">
      <a href={withBase('/negozio')} data-astro-reload>Negozio</a>
      <a href={withBase('/chi-e-claudia')} data-astro-reload>Chi è Claudia</a>
      <a href={withBase('/contatti')} data-astro-reload>Contatti</a>
    </nav>
    <CartButton client:load />
    <CartDrawer client:load />
  </header>

  <main id="contenuto">
    <!-- ================= HERO — l'unico momento a effetto ================= -->
    <section class="hero">
      <canvas id="embers" aria-hidden="true"></canvas>
      <div class="hero__copy" data-reveal>
        <p class="eyebrow">Claudia Capitani · Artista esoterica · Roma</p>
        <h1 class="hero__title">Ossa, funghi<br />e magia dal bosco</h1>
        <p class="hero__lede">
          Teschi dipinti a mano, gioielli in osso, altari rituali. Ogni pezzo
          nasce da un materiale naturale e imperfetto — mai due sono davvero
          uguali.
        </p>
        <div class="hero__cta">
          <a class="btn btn--primary" href={withBase('/negozio')} data-astro-reload>Entra nel negozio →</a>
          <a class="btn btn--ghost" href={withBase('/chi-e-claudia')} data-astro-reload>La storia di Claudia</a>
        </div>
        <p class="hero__hint">Gira la carta per leggere la sua storia →</p>
      </div>

      <div class="hero__stage">
        <div class="card-scene">
          <div class="card" id="hero-card">
            <div class="card__inner">
              <button type="button" class="card__face card__face--front hero-card__face" data-action="flip" aria-label="Gira la carta per leggere la storia di Claudia">
                <canvas id="hero-sigil" aria-hidden="true"></canvas>
                <p class="hero-card__wordmark">Magic Bones</p>
                <p class="hero-card__hint">tocca per girare</p>
              </button>
              <button type="button" class="card__face card__face--back hero-card__back" data-action="flip" aria-label="Torna al sigillo">
                <blockquote class="hero-card__quote">"Nel fitto del bosco, la mia ricerca inizia. Non cerco, ma trovo."</blockquote>
                <p class="hero-card__by">— Claudia Capitani</p>
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Marquee: fascia di testo outline che scorre — energia da bottega, non da template -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee__track">
        <span>Magic Bones · pezzi unici · Roma · dipinti a mano · personalizzazioni su richiesta · </span><span>Magic Bones · pezzi unici · Roma · dipinti a mano · personalizzazioni su richiesta · </span>
      </div>
    </div>

    <!-- ================= CONTENUTO EDITORIALE — DOM semplice ================= -->
    <div class="editorial">
      <section class="block">
        <p class="block__eyebrow">Il bosco in vetrina</p>
        <h2 class="block__title">Scegli per categoria</h2>
        <CategoryTiles client:visible />
      </section>

      <section class="block block--story">
        <div class="story__text">
          <p class="block__eyebrow">La sua ricerca</p>
          <blockquote class="story__quote">
            "Nel fitto del bosco, la mia ricerca inizia. Non cerco, ma trovo."
          </blockquote>
          <p class="story__body">
            Claudia raccoglie, ripulisce e dipinge a mano teschi e ossa
            animali restituiti dal ciclo naturale. Ogni pezzo racconta un
            ritrovamento — mai un acquisto all'ingrosso — e diventa oggetto
            rituale, gioiello o pezzo d'arredo.
          </p>
          <a class="btn btn--ghost-dark" href={withBase('/chi-e-claudia')} data-astro-reload>Conosci Claudia →</a>
        </div>
        <div class="story__gallery">
          <p class="story__gallery-label">Dove arriveranno le foto e i video reali</p>
          <GalleryPreview client:visible />
        </div>
      </section>

      <section class="block">
        <p class="block__eyebrow">Pezzi in evidenza</p>
        <h2 class="block__title">Dal negozio</h2>
        <FeaturedStrip client:visible products={featured} />
        <a class="btn btn--ghost-dark btn--center" href={withBase('/negozio')} data-astro-reload>Vedi tutto il negozio →</a>
      </section>
    </div>

    <footer class="site-footer">
      <p>Magic Bones · Claudia Capitani · Roma</p>
      <p>
        <a href="https://www.instagram.com/_magic_bones" target="_blank" rel="noopener noreferrer">@_magic_bones</a>
        · <a href={withBase('/contatti')} data-astro-reload>Contatti</a> · <a href={withBase('/privacy')} data-astro-reload>Privacy</a> · <a href={withBase('/termini')} data-astro-reload>Termini</a>
      </p>
    </footer>
  </main>

  <script>
    import { setupScrollRestoration } from '../components/world/engine/boot.js';
    import { setupReveal } from '../lib/reveal.js';
    import { pseudo } from '../lib/pseudo';
    import { damp } from '../lib/damp';
    import { mountSigil, seedFromId } from '../lib/sigil';

    setupScrollRestoration();
    setupReveal();

    const prefersReduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // --- La carta-firma dell'hero: sigillo animato (si disegna da solo,
    // poi deriva e pulsa) + gira al tocco --------------------------------
    const heroSigilCanvas = document.getElementById('hero-sigil') as HTMLCanvasElement | null;
    if (heroSigilCanvas) mountSigil(heroSigilCanvas, seedFromId('magic-bones-brand'), '#2fb8c4', 220);

    document.getElementById('hero-card')?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('[data-action="flip"]')) {
        document.getElementById('hero-card')?.classList.toggle('is-flipped');
      }
    });

    // --- Wordmark: le lettere entrano una a una, come battute a timbro ------
    const wordmark = document.querySelector('.hero-card__wordmark');
    if (wordmark && !prefersReduced) {
      const text = wordmark.textContent ?? '';
      wordmark.textContent = '';
      wordmark.setAttribute('aria-label', text);
      [...text].forEach((ch, i) => {
        const span = document.createElement('span');
        span.className = 'wm-letter';
        span.style.animationDelay = `${450 + i * 45}ms`;
        span.textContent = ch;
        span.setAttribute('aria-hidden', 'true');
        wordmark.appendChild(span);
      });
    }

    // --- Fondale dell'hero: braci alla deriva con parallasse sul puntatore --
    // (canvas 2D puro, deterministico via pseudo(); le braci più grandi sono
    // "più vicine" e reagiscono di più al mouse. Si ferma con reduced-motion
    // o tab nascosta/sezione fuori viewport.)
    const embersCanvas = document.getElementById('embers') as HTMLCanvasElement | null;
    if (embersCanvas) {
      const ctx = embersCanvas.getContext('2d')!;
      const narrow = matchMedia('(max-width: 820px)').matches;
      const finePointer = matchMedia('(pointer: fine)').matches;
      const COUNT = narrow ? 26 : 44;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      let w = 0, h = 0;
      const embers = Array.from({ length: COUNT }, (_, i) => ({
        x: pseudo(i * 3), y: pseudo(i * 5), r: 1 + pseudo(i * 7) * 2.4,
        phase: pseudo(i * 11) * Math.PI * 2, speed: 0.15 + pseudo(i * 13) * 0.25,
      }));

      function resize() {
        const rect = embersCanvas!.parentElement!.getBoundingClientRect();
        w = rect.width; h = rect.height;
        embersCanvas!.width = w * dpr; embersCanvas!.height = h * dpr;
        embersCanvas!.style.width = w + 'px'; embersCanvas!.style.height = h + 'px';
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
      resize();
      window.addEventListener('resize', resize, { passive: true });

      let targetPX = 0, targetPY = 0, smoothPX = 0, smoothPY = 0, lastNow = 0;
      if (finePointer && !prefersReduced) {
        embersCanvas.parentElement!.addEventListener('pointermove', (e) => {
          const rect = embersCanvas!.parentElement!.getBoundingClientRect();
          targetPX = (e.clientX - rect.left) / rect.width - 0.5;
          targetPY = (e.clientY - rect.top) / rect.height - 0.5;
        }, { passive: true });
        embersCanvas.parentElement!.addEventListener('pointerleave', () => { targetPX = 0; targetPY = 0; }, { passive: true });
      }

      function draw(time: number, dt = 1 / 60) {
        // Damping legato al tempo reale, non al frame: a 120 Hz la parallasse
        // deve "pesare" come a 60 Hz (vedi lib/damp.ts).
        smoothPX = damp(smoothPX, targetPX, 11, dt);
        smoothPY = damp(smoothPY, targetPY, 11, dt);
        ctx.clearRect(0, 0, w, h);
        embers.forEach((e) => {
          const depth = e.r / 3.4;
          const y = ((e.y - time * e.speed * 0.02) % 1 + 1) % 1;
          const x = e.x + Math.sin(time * 0.4 + e.phase) * 0.02;
          const px = x * w - smoothPX * depth * 46, py = y * h - smoothPY * depth * 34;
          const glow = ctx.createRadialGradient(px, py, 0, px, py, e.r * 6);
          glow.addColorStop(0, 'rgba(255,138,77,0.55)');
          glow.addColorStop(1, 'rgba(255,138,77,0)');
          ctx.fillStyle = glow;
          ctx.beginPath(); ctx.arc(px, py, e.r * 6, 0, Math.PI * 2); ctx.fill();
          ctx.fillStyle = 'rgba(255,205,160,0.9)';
          ctx.beginPath(); ctx.arc(px, py, e.r, 0, Math.PI * 2); ctx.fill();
        });
      }

      if (prefersReduced) {
        draw(0);
      } else {
        let raf = 0;
        const start = performance.now();
        function frame(now: number) {
          raf = requestAnimationFrame(frame);
          if (document.hidden) return;
          const dt = lastNow ? (now - lastNow) / 1000 : 1 / 60;
          lastNow = now;
          draw((now - start) / 1000, dt);
        }
        raf = requestAnimationFrame(frame);

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) { if (!raf) raf = requestAnimationFrame(frame); }
              else { cancelAnimationFrame(raf); raf = 0; }
            });
          },
          { threshold: 0.05 },
        );
        io.observe(embersCanvas.parentElement!);
      }
    }
  </script>

  <style>
    .site-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      padding: 1.25rem 6vw;
      background: var(--paper-warm);
      border-bottom: 1px solid rgba(90, 30, 38, 0.12);
      position: relative;
      z-index: 5;
    }
    .site-header__logo {
      font-family: var(--font-display);
      font-size: 1.4rem;
      font-weight: 600;
      color: var(--bordeaux);
      text-decoration: none;
    }
    .site-header__nav {
      display: flex;
      gap: 1.5rem;
      font-family: var(--font-body);
      font-size: 0.9rem;
    }
    .site-header__nav a {
      color: var(--bordeaux);
      text-decoration: none;
      opacity: 0.8;
    }
    .site-header__nav a:hover {
      opacity: 1;
      text-decoration: underline;
    }

    .hero {
      position: relative;
      overflow: hidden;
      background: var(--bg-night);
      color: var(--bone-cream);
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      align-items: center;
      gap: 2rem;
      padding: 4rem 6vw;
      min-height: 640px;
    }
    #embers {
      position: absolute;
      inset: 0;
      z-index: 0;
      opacity: 0.75;
    }
    .hero__copy, .hero__stage {
      position: relative;
      z-index: 1;
    }
    @media (max-width: 900px) {
      .hero {
        grid-template-columns: 1fr;
        padding: 3rem 6vw 2.5rem;
        min-height: 0;
      }
    }
    .eyebrow {
      font-family: var(--font-flash);
      color: var(--amanita-glow);
      font-size: 0.85rem;
      letter-spacing: 0.05em;
      margin-bottom: 0.6rem;
    }
    .hero__title {
      font-family: var(--font-display);
      font-size: clamp(2.2rem, 4.2vw, 3.4rem);
      line-height: 1.12;
      margin-bottom: 1rem;
    }
    .hero__lede {
      font-family: var(--font-body);
      font-size: 1.02rem;
      line-height: 1.65;
      color: rgba(228, 217, 184, 0.85);
      max-width: 34rem;
      margin-bottom: 1.6rem;
    }
    .hero__cta {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      margin-bottom: 1rem;
    }
    .hero__hint {
      font-family: var(--font-body);
      font-size: 0.78rem;
      color: rgba(228, 217, 184, 0.5);
    }
    @media (max-width: 900px) {
      .hero__hint { display: none; }
    }

    .card-scene {
      position: relative;
      z-index: 1;
      perspective: 1600px;
      aspect-ratio: 4 / 3.4;
    }
    @media (max-width: 900px) {
      .card-scene { aspect-ratio: 4 / 3.1; }
    }
    .card { position: relative; width: 100%; height: 100%; }
    .card__inner {
      position: relative;
      width: 100%;
      height: 100%;
      transform-style: preserve-3d;
      transition: transform 0.7s cubic-bezier(0.22, 0.85, 0.32, 1);
    }
    .card.is-flipped .card__inner { transform: rotateY(180deg); }
    .card__face {
      position: absolute;
      inset: 0;
      backface-visibility: hidden;
      border-radius: var(--radius-lg);
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    .card__face--back { transform: rotateY(180deg); pointer-events: none; }
    .card.is-flipped .card__face--front { pointer-events: none; }
    .card.is-flipped .card__face--back { pointer-events: auto; }

    .hero-card__face {
      background: radial-gradient(ellipse at 50% 32%, #171b2a 0%, #05060b 78%);
      border: 1px solid rgba(228, 217, 184, 0.12);
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 2rem;
      cursor: pointer;
      font: inherit;
      color: inherit;
    }
    #hero-sigil { width: min(220px, 55%); height: auto; }
    .hero-card__wordmark {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: clamp(1.6rem, 3.4vw, 2.3rem);
      color: var(--bone-cream);
      margin-top: 1rem;
    }
    .hero-card__hint {
      font-size: 0.76rem;
      color: rgba(228, 217, 184, 0.45);
      margin-top: 0.6rem;
    }
    .hero-card__back {
      background: var(--paper-warm);
      justify-content: center;
      padding: clamp(1.5rem, 4vw, 3rem);
      border: none;
      text-align: left;
      font: inherit;
      color: inherit;
      cursor: pointer;
    }
    .hero-card__quote {
      font-family: var(--font-display);
      font-style: italic;
      font-size: clamp(1.15rem, 2.2vw, 1.55rem);
      line-height: 1.35;
      color: var(--bordeaux);
      border-left: 2px solid var(--turquoise);
      padding-left: 1rem;
      margin-bottom: 1.25rem;
    }
    .hero-card__by {
      font-size: 0.85rem;
      opacity: 0.7;
    }

    /* Ingresso dell'hero: la carta-firma sale con overshoot; le lettere del
       wordmark entrano una a una come battute a timbro. */
    @keyframes hero-card-rise {
      0% { opacity: 0; transform: translateY(70px) rotate(-4deg) scale(0.92); }
      60% { opacity: 1; transform: translateY(-8px) rotate(1deg) scale(1.015); }
      100% { opacity: 1; transform: translateY(0) rotate(0deg) scale(1); }
    }
    /* Dopo essere salita, la carta LEVITA: un respiro lentissimo che la
       tiene viva senza chiedere attenzione. Le due animazioni si
       concatenano (rise 0.9s, poi float in loop). */
    @keyframes hero-card-float {
      0%, 100% { transform: translateY(0) rotate(0deg); }
      50% { transform: translateY(-10px) rotate(0.5deg); }
    }
    .hero__stage .card {
      animation:
        hero-card-rise 0.9s cubic-bezier(0.22, 0.85, 0.32, 1) 0.15s both,
        hero-card-float 7s ease-in-out 1.05s infinite;
    }
    @keyframes wm-pop {
      0% { opacity: 0; transform: translateY(0.5em) rotate(6deg); }
      100% { opacity: 1; transform: translateY(0) rotate(0deg); }
    }
    :global(.wm-letter) { display: inline-block; white-space: pre; animation: wm-pop 0.5s cubic-bezier(0.22, 0.85, 0.32, 1) both; }

    /* Marquee di testo outline (principio "sticker kit", declinato dark):
       corpo trasparente, contorno bone-cream, scorre piano — via CSS puro. */
    .marquee {
      background: var(--night-deep);
      overflow: hidden;
      padding: 0.9rem 0;
      border-top: 1px solid rgba(228, 217, 184, 0.08);
      border-bottom: 1px solid rgba(228, 217, 184, 0.08);
    }
    .marquee__track {
      display: flex;
      white-space: nowrap;
      width: max-content;
      animation: marquee-scroll 38s linear infinite;
    }
    .marquee__track span {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.6rem;
      letter-spacing: 0.04em;
      color: transparent;
      -webkit-text-stroke: 1px rgba(228, 217, 184, 0.55);
      paint-order: stroke fill;
    }
    @keyframes marquee-scroll {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }

    @media (prefers-reduced-motion: reduce) {
      .card__inner { transition: opacity 0.25s ease; }
      .card.is-flipped .card__inner { transform: none; }
      .card__face--front { transition: opacity 0.25s ease; }
      .card.is-flipped .card__face--front { opacity: 0; pointer-events: none; }
      .card__face--back { transform: none; opacity: 0; transition: opacity 0.25s ease; }
      .card.is-flipped .card__face--back { opacity: 1; }
      .hero__stage .card { animation: none; }
      :global(.wm-letter) { animation: none; }
      .marquee__track { animation: none; }
      /* la sezione media resta scorrevole ma senza scatti */
      html { scroll-behavior: auto; }
    }

    .btn {
      display: inline-block;
      font-family: var(--font-body);
      font-weight: 500;
      font-size: 0.95rem;
      padding: 0.8rem 1.5rem;
      border-radius: 999px;
      text-decoration: none;
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
    }
    /* Bottone "sticker": ombra dura offset + si preme DENTRO la pagina
       (principio playful-motion-brand, inchiostro = notte profonda). */
    .btn--primary {
      background: var(--amanita-glow);
      color: var(--night-deep);
      box-shadow: 4px 4px 0 rgba(5, 6, 11, 0.85);
      transition: transform 0.16s ease, box-shadow 0.16s ease;
    }
    .btn--primary:hover {
      transform: translate(2px, 2px);
      box-shadow: 2px 2px 0 rgba(5, 6, 11, 0.85);
    }
    .btn--primary:active {
      transform: translate(4px, 4px);
      box-shadow: 0 0 0 rgba(5, 6, 11, 0.85);
    }
    .btn--ghost {
      color: var(--bone-cream);
      border: 1px solid rgba(228, 217, 184, 0.3);
    }
    .btn--ghost:hover {
      border-color: var(--turquoise);
      color: var(--turquoise);
    }
    .btn--ghost-dark {
      color: var(--bordeaux);
      border: 1px solid rgba(90, 30, 38, 0.25);
    }
    .btn--ghost-dark:hover {
      border-color: var(--bordeaux);
      background: rgba(90, 30, 38, 0.05);
    }
    .btn--center {
      display: block;
      width: fit-content;
      margin: 2rem auto 0;
    }

    .editorial {
      background: var(--paper-warm);
      color: var(--bordeaux);
    }
    .block {
      max-width: 72rem;
      margin: 0 auto;
      padding: 4.5rem 6vw;
    }
    .block__eyebrow {
      font-family: var(--font-flash);
      color: var(--bordeaux);
      opacity: 0.7;
      font-size: 0.85rem;
      margin-bottom: 0.5rem;
    }
    .block__title {
      font-family: var(--font-display);
      font-size: clamp(1.7rem, 3vw, 2.3rem);
      margin-bottom: 2rem;
    }

    .block--story {
      display: grid;
      grid-template-columns: 0.85fr 1.15fr;
      gap: 3rem;
      align-items: start;
    }
    @media (max-width: 900px) {
      .block--story { grid-template-columns: 1fr; gap: 2.5rem; }
    }
    .story__quote {
      font-family: var(--font-display);
      font-style: italic;
      font-size: 1.5rem;
      line-height: 1.35;
      color: var(--bordeaux);
      margin: 0.5rem 0 1.25rem;
      border-left: 2px solid var(--turquoise);
      padding-left: 1rem;
    }
    .story__body {
      font-family: var(--font-body);
      line-height: 1.7;
      color: rgba(90, 30, 38, 0.9);
      margin-bottom: 1.5rem;
    }
    .story__gallery-label {
      font-family: var(--font-body);
      font-size: 0.8rem;
      color: rgba(90, 30, 38, 0.6);
      margin-bottom: 1rem;
    }

    .site-footer {
      background: var(--paper-warm);
      border-top: 1px solid rgba(90, 30, 38, 0.12);
      padding: 2rem 6vw;
      font-family: var(--font-body);
      font-size: 0.82rem;
      color: rgba(90, 30, 38, 0.75);
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .site-footer a {
      color: inherit;
    }
  </style>
</BaseLayout>
