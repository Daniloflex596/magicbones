---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { CartButton } from '../components/shop/CartButton';
import { CartDrawer } from '../components/shop/CartDrawer';
import { CategoryTiles } from '../components/home/CategoryTiles';
import { GalleryPreview } from '../components/home/GalleryPreview';
import { FeaturedStrip } from '../components/home/FeaturedStrip';
import { toPlainProduct } from '../lib/types';
import { withBase } from '../lib/url';

const entries = await getCollection('products');
const featured = entries.filter((e) => e.data.featured).slice(0, 4).map(toPlainProduct);
---

<BaseLayout
  title="Teschi dipinti, gioielli in osso e altari rituali"
  description="Magic Bones — Claudia Capitani, Roma. Teschi dipinti a mano, gioielli in osso, altari rituali. Pezzi unici, personalizzabili su richiesta."
>
  <header class="site-header">
    <a href={withBase('/')} class="site-header__logo">Magic Bones</a>
    <nav class="site-header__nav">
      <a href={withBase('/negozio')} data-astro-reload>Negozio</a>
      <a href={withBase('/chi-e-claudia')} data-astro-reload>Chi è Claudia</a>
      <a href={withBase('/contatti')} data-astro-reload>Contatti</a>
    </nav>
    <CartButton client:load />
    <CartDrawer client:load />
  </header>

  <main id="contenuto">
    <!-- ================= HERO — l'unico momento a effetto ================= -->
    <section class="hero">
      <div class="hero__copy" data-reveal>
        <p class="eyebrow">Claudia Capitani · Artista esoterica · Roma</p>
        <h1 class="hero__title">Ossa, funghi<br />e magia dal bosco</h1>
        <p class="hero__lede">
          Teschi dipinti a mano, gioielli in osso, altari rituali. Ogni pezzo
          nasce da un materiale naturale e imperfetto — mai due sono davvero
          uguali.
        </p>
        <div class="hero__cta">
          <a class="btn btn--primary" href={withBase('/negozio')} data-astro-reload>Entra nel negozio →</a>
          <a class="btn btn--ghost" href={withBase('/chi-e-claudia')} data-astro-reload>La storia di Claudia</a>
        </div>
        <p class="hero__hint">Trascina per far ruotare il teschio →</p>
      </div>

      <div class="hero__stage">
        <div id="stage-fallback" class="stage-fallback" aria-hidden="true">
          <svg viewBox="0 0 64 64" width="96" height="96">
            <path
              d="M32 14c-10 0-16 7-16 16 0 6 2.5 10 5 12.5V50h4.5v-4h3.5v4H33v-4h3.5v4H41v-7.5c2.5-2.5 5-6.5 5-12.5 0-9-6-16-16-16Z"
              fill="none" stroke="#e4d9b8" stroke-width="1.6" stroke-linejoin="round" opacity="0.55"
            />
            <circle cx="25.5" cy="27" r="2.6" fill="#2fb8c4" opacity="0.7" />
            <circle cx="38.5" cy="27" r="2.6" fill="#2fb8c4" opacity="0.7" />
          </svg>
        </div>
        <canvas id="hero-canvas" aria-hidden="true"></canvas>
      </div>
    </section>

    <!-- ================= CONTENUTO EDITORIALE — DOM semplice ================= -->
    <div class="editorial">
      <section class="block">
        <p class="block__eyebrow">Il bosco in vetrina</p>
        <h2 class="block__title">Scegli per categoria</h2>
        <CategoryTiles client:visible />
      </section>

      <section class="block block--story">
        <div class="story__text">
          <p class="block__eyebrow">La sua ricerca</p>
          <blockquote class="story__quote">
            "Nel fitto del bosco, la mia ricerca inizia. Non cerco, ma trovo."
          </blockquote>
          <p class="story__body">
            Claudia raccoglie, ripulisce e dipinge a mano teschi e ossa
            animali restituiti dal ciclo naturale. Ogni pezzo racconta un
            ritrovamento — mai un acquisto all'ingrosso — e diventa oggetto
            rituale, gioiello o pezzo d'arredo.
          </p>
          <a class="btn btn--ghost-dark" href={withBase('/chi-e-claudia')} data-astro-reload>Conosci Claudia →</a>
        </div>
        <div class="story__gallery">
          <p class="story__gallery-label">Dove arriveranno le foto e i video reali</p>
          <GalleryPreview client:visible />
        </div>
      </section>

      <section class="block">
        <p class="block__eyebrow">Pezzi in evidenza</p>
        <h2 class="block__title">Dal negozio</h2>
        <FeaturedStrip client:visible products={featured} />
        <a class="btn btn--ghost-dark btn--center" href={withBase('/negozio')} data-astro-reload>Vedi tutto il negozio →</a>
      </section>
    </div>

    <footer class="site-footer">
      <p>Magic Bones · Claudia Capitani · Roma</p>
      <p>
        <a href="https://www.instagram.com/_magic_bones" target="_blank" rel="noopener noreferrer">@_magic_bones</a>
        · <a href={withBase('/contatti')} data-astro-reload>Contatti</a> · <a href={withBase('/privacy')} data-astro-reload>Privacy</a> · <a href={withBase('/termini')} data-astro-reload>Termini</a>
      </p>
    </footer>
  </main>

  <script>
    import { setupScrollRestoration } from '../components/world/engine/boot.js';
    import { detectTier } from '../components/world/engine/capability.js';
    import { setupReveal } from '../lib/reveal.js';

    setupScrollRestoration();
    setupReveal();

    const canvas = document.getElementById('hero-canvas');
    const fallback = document.getElementById('stage-fallback');
    const tier = detectTier();
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (tier === 'none' || !canvas) {
      // Nessun canvas creato, nessun chunk 3D scaricato: il fallback statico
      // resta l'unica cosa visibile nello stage (progressive enhancement).
    } else {
      canvas.style.display = 'block';
      fallback?.style.setProperty('display', 'none');

      import('../components/world/hero-stage.js').then(({ initHeroStage }) => {
        const stage = initHeroStage(canvas, { tier, reducedMotion });
        const container = canvas.parentElement;

        function resizeStage() {
          const rect = container.getBoundingClientRect();
          stage.resize(rect.width, rect.height);
        }
        resizeStage();
        window.addEventListener('resize', resizeStage, { passive: true });

        stage.ready.then(() => stage.start());

        // Pausa il loop quando lo stage esce dal viewport (batteria/GPU).
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) stage.resume();
              else stage.pause();
            });
          },
          { threshold: 0.05 },
        );
        io.observe(container);

        document.addEventListener('visibilitychange', () => {
          if (document.hidden) stage.pause();
          else if (container.getBoundingClientRect().top < window.innerHeight) stage.resume();
        });
      });
    }
  </script>

  <style>
    .site-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      padding: 1.25rem 6vw;
      background: var(--paper-warm);
      border-bottom: 1px solid rgba(90, 30, 38, 0.12);
      position: relative;
      z-index: 5;
    }
    .site-header__logo {
      font-family: var(--font-display);
      font-size: 1.4rem;
      font-weight: 600;
      color: var(--bordeaux);
      text-decoration: none;
    }
    .site-header__nav {
      display: flex;
      gap: 1.5rem;
      font-family: var(--font-body);
      font-size: 0.9rem;
    }
    .site-header__nav a {
      color: var(--bordeaux);
      text-decoration: none;
      opacity: 0.8;
    }
    .site-header__nav a:hover {
      opacity: 1;
      text-decoration: underline;
    }

    .hero {
      background: var(--bg-night);
      color: var(--bone-cream);
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      align-items: center;
      gap: 2rem;
      padding: 4rem 6vw;
      min-height: 640px;
    }
    @media (max-width: 900px) {
      .hero {
        grid-template-columns: 1fr;
        padding: 3rem 6vw 2.5rem;
        min-height: 0;
      }
    }
    .eyebrow {
      font-family: var(--font-flash);
      color: var(--amanita-glow);
      font-size: 0.85rem;
      letter-spacing: 0.05em;
      margin-bottom: 0.6rem;
    }
    .hero__title {
      font-family: var(--font-display);
      font-size: clamp(2.2rem, 4.2vw, 3.4rem);
      line-height: 1.12;
      margin-bottom: 1rem;
    }
    .hero__lede {
      font-family: var(--font-body);
      font-size: 1.02rem;
      line-height: 1.65;
      color: rgba(228, 217, 184, 0.85);
      max-width: 34rem;
      margin-bottom: 1.6rem;
    }
    .hero__cta {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      margin-bottom: 1rem;
    }
    .hero__hint {
      font-family: var(--font-body);
      font-size: 0.78rem;
      color: rgba(228, 217, 184, 0.5);
    }
    @media (max-width: 900px) {
      .hero__hint { display: none; }
    }

    .hero__stage {
      position: relative;
      aspect-ratio: 4 / 3.4;
      border-radius: var(--radius-lg);
      overflow: hidden;
      background: radial-gradient(ellipse at 50% 30%, #1c1f2e 0%, #05060b 75%);
      border: 1px solid rgba(228, 217, 184, 0.1);
    }
    @media (max-width: 900px) {
      .hero__stage { aspect-ratio: 4 / 3.2; }
    }
    #hero-canvas {
      width: 100%;
      height: 100%;
      display: none;
      touch-action: none;
      cursor: grab;
    }
    #hero-canvas:active {
      cursor: grabbing;
    }
    .stage-fallback {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .btn {
      display: inline-block;
      font-family: var(--font-body);
      font-weight: 500;
      font-size: 0.95rem;
      padding: 0.8rem 1.5rem;
      border-radius: 999px;
      text-decoration: none;
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
    }
    .btn--primary {
      background: var(--amanita-glow);
      color: var(--night-deep);
    }
    .btn--primary:hover {
      transform: translateY(-2px) scale(1.03);
      box-shadow: 0 8px 24px rgba(255, 138, 77, 0.35);
    }
    .btn--ghost {
      color: var(--bone-cream);
      border: 1px solid rgba(228, 217, 184, 0.3);
    }
    .btn--ghost:hover {
      border-color: var(--turquoise);
      color: var(--turquoise);
    }
    .btn--ghost-dark {
      color: var(--bordeaux);
      border: 1px solid rgba(90, 30, 38, 0.25);
    }
    .btn--ghost-dark:hover {
      border-color: var(--bordeaux);
      background: rgba(90, 30, 38, 0.05);
    }
    .btn--center {
      display: block;
      width: fit-content;
      margin: 2rem auto 0;
    }

    .editorial {
      background: var(--paper-warm);
      color: var(--bordeaux);
    }
    .block {
      max-width: 72rem;
      margin: 0 auto;
      padding: 4.5rem 6vw;
    }
    .block__eyebrow {
      font-family: var(--font-flash);
      color: var(--bordeaux);
      opacity: 0.7;
      font-size: 0.85rem;
      margin-bottom: 0.5rem;
    }
    .block__title {
      font-family: var(--font-display);
      font-size: clamp(1.7rem, 3vw, 2.3rem);
      margin-bottom: 2rem;
    }

    .block--story {
      display: grid;
      grid-template-columns: 0.85fr 1.15fr;
      gap: 3rem;
      align-items: start;
    }
    @media (max-width: 900px) {
      .block--story { grid-template-columns: 1fr; gap: 2.5rem; }
    }
    .story__quote {
      font-family: var(--font-display);
      font-style: italic;
      font-size: 1.5rem;
      line-height: 1.35;
      color: var(--bordeaux);
      margin: 0.5rem 0 1.25rem;
      border-left: 2px solid var(--turquoise);
      padding-left: 1rem;
    }
    .story__body {
      font-family: var(--font-body);
      line-height: 1.7;
      color: rgba(90, 30, 38, 0.9);
      margin-bottom: 1.5rem;
    }
    .story__gallery-label {
      font-family: var(--font-body);
      font-size: 0.8rem;
      color: rgba(90, 30, 38, 0.6);
      margin-bottom: 1rem;
    }

    .site-footer {
      background: var(--paper-warm);
      border-top: 1px solid rgba(90, 30, 38, 0.12);
      padding: 2rem 6vw;
      font-family: var(--font-body);
      font-size: 0.82rem;
      color: rgba(90, 30, 38, 0.75);
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .site-footer a {
      color: inherit;
    }
  </style>
</BaseLayout>
