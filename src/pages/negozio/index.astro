---
import { getCollection } from 'astro:content';
import ShopLayout from '../../layouts/ShopLayout.astro';
import { ProductGrid } from '../../components/shop/ProductGrid';
import { toPlainProduct } from '../../lib/types';

const entries = await getCollection('products');
entries.sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
const products = entries.map(toPlainProduct);

const initialCategory = Astro.url.searchParams.get('categoria') ?? undefined;
---

<ShopLayout
  title="Negozio"
  description="Teschi dipinti a mano, gioielli in osso e altari rituali di Magic Bones — pezzi unici e personalizzabili."
>
  <div class="intro">
    <p class="eyebrow">Il negozio</p>
    <h1>Porta a casa un pezzo del bosco</h1>
    <p class="lede">
      Ogni pezzo è fatto a mano da Claudia, spesso unico. Aggiungi al carrello e
      invia una richiesta: ti risponde lei personalmente per confermare
      disponibilità, misure e spedizione.
    </p>
  </div>

  <ProductGrid client:load products={products} initialCategory={initialCategory} />

  <style>
    .intro {
      max-width: 42rem;
      margin-bottom: 3rem;
    }
    .eyebrow {
      font-family: var(--font-flash);
      color: var(--bordeaux);
      opacity: 0.7;
      font-size: 0.9rem;
      margin-bottom: 0.4rem;
    }
    h1 {
      font-family: var(--font-display);
      font-size: clamp(2rem, 4vw, 2.75rem);
      color: var(--bordeaux);
      margin-bottom: 0.9rem;
    }
    .lede {
      font-family: var(--font-body);
      color: rgba(90, 30, 38, 0.85);
      line-height: 1.6;
    }
  </style>
</ShopLayout>
